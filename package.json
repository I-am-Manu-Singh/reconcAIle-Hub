{
  "name": "reconcaile-hub",
  "productName": "ReconcAILe Hub",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop ReconcAILe Hub with a secure local connector architecture for TallyPrime and future accounting systems.",
  "author": "CreativeBlissLabs",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json && cp dist/preload/preload.js dist/preload/preload.cjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "rebuild:native": "electron-rebuild",
    "dev": "vite --host 127.0.0.1",
    "electron": "electron .",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.creativeblisslabs.app",
    "productName": "ReconcAILe Hub",
    "directories": {
      "output": "dist/installer"
    },
    "files": [
      "dist/**/*",
      "build/**/*",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "category": "public.app-category.business",
      "identity": null
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "better-sqlite3": "^11.8.1",
    "date-fns": "^4.4.0",
    "fast-xml-parser": "^5.10.1",
    "fuse.js": "^7.5.0",
    "groq-sdk": "^1.6.0",
    "keytar": "^7.9.0",
    "node-llama-cpp": "^3.22.2",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "lucide-react": "^1.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
